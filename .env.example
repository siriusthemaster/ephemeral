# Alchemy key (Pay As You Go plan). The free plan limits eth_getLogs to 10 blocks per call on Ethereum,
# which makes a historical scan impractical. Never commit .env and never paste this key into a chat.
ALCHEMY_KEY=

# Optional: any other RPC URL. alchemy_getAssetTransfers is Alchemy-only, so a non-Alchemy URL
# works for logs and transactions but the withdrawal lookup step needs Alchemy.
# RPC_URL=
